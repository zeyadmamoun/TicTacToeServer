<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alphaserver.FXMLDocumentController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="606.0" pickOnBounds="true">
         <image>
            <Image url="@/assets/background1.png" />
         </image>
      </ImageView>
    
      <BorderPane fx:id="borderPane" layoutX="6.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: transparent;">
        
      
          <bottom>
              <Button fx:id="button" mnemonicParsing="false" onAction="#handleButtonAction" style="-fx-background-color: transparent; -fx-border-color: #00ffff; -fx-border-radius: 10px; -fx-border-width: 5px;" text="Start Server" textFill="WHITE" BorderPane.alignment="CENTER">
                  <font>
                      <Font size="24.0" />
                  
                  </font>
                  <BorderPane.margin>
                      <Insets bottom="15.0" />
                  </BorderPane.margin>
              </Button>
          </bottom>
      </BorderPane>
   </children>
</Pane>
